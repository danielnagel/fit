{
  "name": "fit-backend",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "pretest": "docker compose -f ../docker-compose.test.yml up -d --wait fit-db",
    "test": "vitest run",
    "test:watch": "vitest",
    "user:create": "node dist/cli/user.js create",
    "user:list": "node dist/cli/user.js list",
    "user:set-password": "node dist/cli/user.js set-password",
    "user:delete": "node dist/cli/user.js delete",
    "user:assign-data": "node dist/cli/user.js assign-data"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
